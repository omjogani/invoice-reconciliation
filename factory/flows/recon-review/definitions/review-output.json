{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review output",
  "description": "What a review worker returns for one batch. It carries no amounts: every figure comes from the reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_session_id", "batch_id", "items"],
  "properties": {
    "_session_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^B[0-9]{2,}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "disposition", "raised_reason", "justification", "memo_markdown"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["accept", "dispute", "escalate"]},
          "raised_reason": {"type": ["string", "null"]},
          "justification": {"type": "string", "minLength": 20, "maxLength": 1200},
          "memo_markdown": {"type": "string", "minLength": 80}
        }
      }
    }
  }
}
